# Streamlit Community Cloud Secrets Template
# When deploying to https://share.streamlit.io:
# 1. Open your App settings
# 2. Go to "Secrets"
# 3. Paste the contents below with your actual Groq API key:

GROQ_API_KEY = "your-groq-api-key-here"
GROQ_TEXT_MODEL = "openai/gpt-oss-120b"
GROQ_VISION_MODEL = "qwen/qwen3.8-27b"
